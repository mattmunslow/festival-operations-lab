# Copy this file to .env and fill in every value.
# .env is ignored by Git, so your keys stay on your machine.

# ---------- Microsoft Foundry project ----------
# Foundry portal > your project > Overview > "Project endpoint"
# Looks like: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://matt-9712-resource.services.ai.azure.com/api/projects/matt-9712-resource-project

# The name you gave your agent in the Foundry portal
FOUNDRY_AGENT_NAME=festival-operations-assistant

# The deployment name of the model you deployed (used for image analysis)
FOUNDRY_MODEL_DEPLOYMENT=gpt-5

# ---------- Foundry resource keys ----------
# Azure portal > your Foundry resource > Resource Management > Keys and Endpoint
# Use KEY 1 for every key below.

# Azure AI Speech: the resource's Location/Region, e.g. swedencentral
SPEECH_KEY=
SPEECH_REGION=

# Azure AI Language: https://<resource>.cognitiveservices.azure.com/
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Content Understanding: https://<resource>.services.ai.azure.com/
CONTENT_UNDERSTANDING_ENDPOINT=
CONTENT_UNDERSTANDING_KEY=
